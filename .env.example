# Copia este archivo como `.env` (junto a docker-compose.yml) y cambia los valores.
# `.env` NO se sube a Git.

# --- Base de datos ---
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
DB_NAME=becal_db
DB_USER=becal_user
DB_PASSWORD=cambia-esta-clave

# --- Seguridad ---
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Administrador (se crea al iniciar si no existe) ---
ADMIN_EMAIL=admin@belaaktun.com
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

# --- Correo (Gmail: usa una "contraseña de aplicación") ---
MAIL_USERNAME=belaaktun@gmail.com
MAIL_PASSWORD=

# --- Opcionales ---
# Orígenes del frontend autorizados (separados por coma)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Si el backend va detrás de nginx/balanceador, pon TRUST_PROXY=1
# PUBLIC_BASE_URL=https://api.tudominio.com

# --- Despliegue con nginx (docker compose up -d --build) ---
# Puerto público del sitio (80 por defecto)
# WEB_PORT=80
# Mensajes de contacto permitidos por IP y por hora (sube el valor mientras haces pruebas)
# CONTACTO_MAX_POR_HORA=5
# Si MAIL_USERNAME está vacío no se envían correos (el sitio funciona igual)

# --- Pruebas Selenium (./deploy/run-e2e.sh) ---
E2E_ADMIN_EMAIL=e2e-admin@belaaktun.test
E2E_ADMIN_PASSWORD=
E2E_ARTESANO_EMAIL=acosta@belaaktun.com
E2E_ARTESANO_PASSWORD=
